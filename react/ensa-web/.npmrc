# rich-react-component declares react ^18 as a peer dependency while this SPA is on React 19.
# The library is React-19 compatible in practice — it uses no removed API — but npm's default
# strict peer resolution refuses to install it, so a fresh clone could not run `npm install` at
# all without this flag.
#
# Added 2026-08-28. Delete it as soon as the library widens the peer range to
# "^18 || ^19"; until then every install of this project carries the exception silently, which
# is exactly why it is written down here rather than typed by each developer.
legacy-peer-deps=true
