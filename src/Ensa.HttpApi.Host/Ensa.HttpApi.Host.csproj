<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="*" />
    <PackageReference Include="OpenIddict.AspNetCore" Version="*" />
    <PackageReference Include="Serilog.AspNetCore" Version="*" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ensa.HttpApi\Ensa.HttpApi.csproj" />
    <ProjectReference Include="..\Ensa.Application\Ensa.Application.csproj" />
    <ProjectReference Include="..\Ensa.EntityFrameworkCore\Ensa.EntityFrameworkCore.csproj" />
  </ItemGroup>


  <ItemGroup>
    <!--
      Never publish the machine-local settings file.

      appsettings.{Environment}.local.json is where a real connection string lives - it is loaded
      last and .gitignore excludes it, because this repository is public. dotnet publish picks it
      up anyway through the default appsettings*.json glob, which puts the database password into
      every deployment artifact and undoes the whole arrangement. A deployment supplies its own
      connection string through ConnectionStrings__Default or a key vault.
    -->
    <Content Update="appsettings.*.local.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>
